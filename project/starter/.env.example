# =============================================================================
# Fitness Tracker - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values. Never commit the real .env
# file to version control (it must be listed in .gitignore).
# Docker Compose loads these values into the containers.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Credentials used by the PostgreSQL container. These are local-development
# defaults; use different values anywhere the database is reachable by others.
POSTGRES_USER=fitness_user
POSTGRES_PASSWORD=fitness_password
POSTGRES_DB=fitness_tracker

# Connection string used by the backend. The host is the Compose service name,
# and the driver prefix must be postgresql+psycopg (psycopg 3).
# Keep the user, password, and database name in sync with the values above.
DATABASE_URL=postgresql+psycopg://fitness_user:fitness_password@postgres:5432/fitness_tracker

# -----------------------------------------------------------------------------
# JWT authentication
# -----------------------------------------------------------------------------
# REQUIRED. Intentionally blank: the backend refuses to start until this is set
# to a random value of at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Access-token lifetime in minutes (read by auth.py).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API (read by
# main.py). The default matches the Streamlit frontend.
CORS_ORIGINS=http://localhost:8501

# -----------------------------------------------------------------------------
# RAG / AI (added with the Module 9 RAG files)
# -----------------------------------------------------------------------------
# OLLAMA_URL=http://ollama:11434
# MODEL_NAME=
# CHROMA_PATH=
# CONFIDENCE_THRESHOLD=
# TOP_K=