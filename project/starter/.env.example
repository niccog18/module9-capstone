# ── Environment Variables ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values. docker-compose.yml and
# backend/database.py, backend/auth.py, backend/rag_pipeline.py should all
# read their settings from here — never hardcode secrets in source files.
#
# Usage:
#   cp .env.example .env

# Database
DATABASE_URL=sqlite:///./data/app.db

# JWT authentication
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# RAG pipeline
CHROMA_PATH=./rag_db
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
MODEL_NAME=llama3.2:1b
# If using an API-based LLM instead of Ollama:
# OPENAI_API_KEY=

# Frontend → Backend URL (inside Docker Compose, use the service name)
BACKEND_URL=http://backend:8000

# Debug mode
DEBUG=false
